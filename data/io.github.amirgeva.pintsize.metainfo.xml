<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.amirgeva.pintsize</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Pint-Size Prix</name>
  <summary>Top-down racing with thumb-sized vehicles</summary>
  <developer id="io.github.amirgeva">
    <name>Amir Geva</name>
  </developer>
  <description>
    <p>
      Pint-Size Prix is a top-down miniature racing game. Thumb-sized
      vehicles race across everyday places: a breakfast table, a woodworking
      bench, a freezer drawer, a sink full of dishes, an office desk and a
      backyard sandbox.
    </p>
    <ul>
      <li>Six courses, each with its own vehicle and handling</li>
      <li>Tournament, head-to-head and time trial modes</li>
      <li>Two players can share one keyboard</li>
      <li>Computer drivers that plan their own racing line</li>
      <li>All graphics and sound are generated by the game itself</li>
    </ul>
  </description>
  <launchable type="desktop-id">pintsize.desktop</launchable>
  <url type="homepage">https://github.com/amirgeva/pintsize</url>
  <url type="bugtracker">https://github.com/amirgeva/pintsize/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>Racing on the kitchen table</caption>
      <image>https://raw.githubusercontent.com/amirgeva/pintsize/main/docs/intro.gif</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Game</category>
    <category>ArcadeGame</category>
  </categories>
  <keywords>
    <keyword>racing</keyword>
    <keyword>cars</keyword>
    <keyword>arcade</keyword>
  </keywords>
  <supports>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">mild</content_attribute>
  </content_rating>
  <releases>
